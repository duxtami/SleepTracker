<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <!-- ic_launcher_foreground.png is glyph-only (no baked-in circle) - the flat
         ic_launcher_background.xml navy fill IS the circle, drawn edge-to-edge with zero
         resize artifacts, then cropped cleanly by whatever mask shape the launcher applies.
         Baking a second, separately-scaled navy circle into the foreground (an earlier
         version of this file) created a visible seam/ring where that circle's own
         anti-aliased raster edge didn't sit at a shared boundary with the background layer -
         this avoids that entirely by only ever having one navy edge: the mask's own.
         Sizing: Android's adaptive icon spec actually names two different circles on the
         108dp canvas - a 66dp "safe zone" that's mathematically guaranteed never clipped by
         literally any possible mask shape, and a 72dp "keyline" circle that Android's own
         Asset Studio template uses as the intended content boundary and that real launchers
         (Pixel Launcher, most OEM launchers) actually render up to. Sizing to the stricter
         66dp boundary was leaving this looking smaller/more padded than a typical, properly-
         filled app icon. This asset is now sized against the 72dp keyline instead - its
         farthest pixel sits ~12px inside that boundary (in a 1024px working canvas, about 1%
         of the canvas) - matching how most real-world adaptive icons are actually sized, at
         the cost of no longer being provably safe against the rare, unusually aggressive mask
         shape that clips tighter than 72dp. Positioned using the same scale+origin the full
         circular badge would use (not re-centered on the glyph's own off-center bounding
         box), so it sits exactly where it does in the source artwork, just larger. -->
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <!-- Reuses the same foreground artwork for Android 13+ themed icons: the system only
         reads this layer's alpha channel and paints it with the user's chosen tint color, so
         the underlying source pixels don't matter - only the silhouette shape does, which
         this file already has. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
