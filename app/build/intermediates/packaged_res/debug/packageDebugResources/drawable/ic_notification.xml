<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar / notification icon: three ascending "Z"s only - no mascot, no background
  shape, no fill. Android renders this using only its alpha channel (shown as a flat white
  or system-tinted silhouette), so it stays legible on both light and dark status bars
  automatically; the point of pure-stroke, no-fill geometry here is to keep it bold and
  simple enough to read at 24dp, per Android's guidance that status bar icons be simple,
  singular, and uncluttered.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <group android:pivotX="12" android:pivotY="15" android:rotation="-10"
        android:translateX="28" android:translateY="135">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="15"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M0,0 L24,0 L0,30 L24,30" />
    </group>
    <group android:pivotX="17" android:pivotY="21" android:rotation="-10"
        android:translateX="69" android:translateY="87">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="15"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M0,0 L34,0 L0,42 L34,42" />
    </group>
    <group android:pivotX="23" android:pivotY="28" android:rotation="-10"
        android:translateX="119" android:translateY="30">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="15"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M0,0 L46,0 L0,56 L46,56" />
    </group>

</vector>
