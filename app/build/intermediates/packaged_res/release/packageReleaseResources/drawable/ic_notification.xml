<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar / notification icon. Rendered by Android using only its alpha channel
  (always shown as a flat white or system-tinted silhouette). Reuses the same dome +
  antennae + closed-eyes silhouette as the launcher mark, using the master logo's own
  1024x1024 coordinate space directly (no offset needed here). The three "Z"s are
  intentionally omitted at this size - Android's guidelines call for simple, singular,
  uncluttered notification icons, and the "Z"s would just muddy into noise at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="75"
        android:strokeLineCap="round"
        android:pathData="M216,462 L373.3,851.4" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="75"
        android:strokeLineCap="round"
        android:pathData="M808,462 L650.7,851.4" />

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M 512,1064 m -480,0
            a 480,480 0 1,0 960,0
            a 480,480 0 1,0 -960,0
            Z
            M204,827.5 h166 a10,10 0 0 1 10,10 v11 a10,10 0 0 1 -10,10 h-166 a10,10 0 0 1 -10,-10 v-11 a10,10 0 0 1 10,-10 Z
            M654,827.5 h166 a10,10 0 0 1 10,10 v11 a10,10 0 0 1 -10,10 h-166 a10,10 0 0 1 -10,-10 v-11 a10,10 0 0 1 10,-10 Z
        " />

</vector>
