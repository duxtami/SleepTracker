<?xml version="1.0" encoding="utf-8"?>
<!--
  SleepTracker mark v5: sleeping Android-style head (dome + two antennae, closed dash
  eyes) plus a fully redesigned "zzZ" - all three Z's now share one constant stroke width
  and one constant rotation, with only the glyph's own footprint growing per step, so the
  cluster reads as one deliberate flourish instead of a scaled-up copy of the same sticker.

  Master source: sleeptracker_logo.svg (1024x1024, design/logo/). This file reproduces the
  exact same coordinates/colors, offset by +256 on both axes and placed in a 1536x1536
  viewport so the artwork occupies the recommended ~66% safe zone of the 108dp adaptive
  icon canvas (Pixel Launcher, Nothing OS, One UI, and other Material You launcher masks).

  Eyes are cut from the dome as true negative space (evenOdd), so they read as closed-eye
  dashes rather than a second flat color.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1536"
    android:viewportHeight="1536">

    <!-- Antennae (base intentionally sits under the dome, same fill color = seamless) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E5EAF0"
        android:strokeWidth="75"
        android:strokeLineCap="round"
        android:pathData="M472,718 L629.3,1107.4" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E5EAF0"
        android:strokeWidth="75"
        android:strokeLineCap="round"
        android:pathData="M1064,718 L906.7,1107.4" />

    <!-- Dome with closed eyes cut out as negative space -->
    <path
        android:fillColor="#E5EAF0"
        android:fillType="evenOdd"
        android:pathData="
            M 768,1320 m -480,0
            a 480,480 0 1,0 960,0
            a 480,480 0 1,0 -960,0
            Z
            M460,1083.5 h166 a10,10 0 0 1 10,10 v11 a10,10 0 0 1 -10,10 h-166 a10,10 0 0 1 -10,-10 v-11 a10,10 0 0 1 10,-10 Z
            M910,1083.5 h166 a10,10 0 0 1 10,10 v11 a10,10 0 0 1 -10,10 h-166 a10,10 0 0 1 -10,-10 v-11 a10,10 0 0 1 10,-10 Z
        " />

    <!-- zzZ v2 (redesigned): constant stroke width (34) and constant rotation (-12°) on all
         three - only each glyph's own width/height grows (70x86, 94x114, 122x146). Placed
         along a steeper ascent line than the glyphs' own tilt, with a verified >150-unit gap
         from the nearest antenna and zero overlap with the dome or with each other. -->
    <group android:pivotX="35" android:pivotY="43" android:rotation="-12"
        android:translateX="691" android:translateY="623">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E5EAF0"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M0,0 L70,0 L0,86 L70,86" />
    </group>
    <group android:pivotX="47" android:pivotY="57" android:rotation="-12"
        android:translateX="874.09" android:translateY="518.04">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E5EAF0"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M0,0 L94,0 L0,114 L94,114" />
    </group>
    <group android:pivotX="61" android:pivotY="73" android:rotation="-12"
        android:translateX="1094.48" android:translateY="392.76">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E5EAF0"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M0,0 L122,0 L0,146 L122,146" />
    </group>

</vector>
