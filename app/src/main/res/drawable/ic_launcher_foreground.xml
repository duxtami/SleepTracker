<?xml version="1.0" encoding="utf-8"?>
<!--
  SleepTracker mark v3: a plumped pillow, rendered as pure geometry.

  Concept selected from 8 distinct directions (see design notes) for the strongest
  combination of instant category recognition, simplicity, monochrome readability and
  small-size visibility - the criteria that matter most for a launcher icon. Replaces
  the earlier crescent-moon-and-star concept entirely; no moon, star, orbit or blob
  carried forward.

  Built as a single flat path, evenOdd fill:
  - Outer subpath: a large-radius rounded rect ("squircle") - the pillow body.
  - Inner subpath: a thin almond/lens shape near the top, which evenOdd punches out as
    a hole, revealing the background color beneath. This reads as a soft plumped fold
    without any stitching, texture, or skeuomorphic shading - just negative space.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#DCE4E9"
        android:fillType="evenOdd"
        android:pathData="M38,32
            L70,32
            A18,18 0 0 1 88,50
            L88,58
            A18,18 0 0 1 70,76
            L38,76
            A18,18 0 0 1 20,58
            L20,50
            A18,18 0 0 1 38,32 Z
            M32,48
            Q54,39 76,48
            Q54,46 32,48 Z" />
</vector>
