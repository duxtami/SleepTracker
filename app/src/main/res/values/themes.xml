<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SleepTracker" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash theme: same muted slate background and pillow mark used everywhere else,
         so the launch experience matches the launcher icon and app identity. Hands off to
         the real app theme via postSplashScreenTheme once Compose takes over. -->
    <style name="Theme.SleepTracker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#3A4750</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SleepTracker</item>
    </style>
</resources>
